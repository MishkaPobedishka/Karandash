      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "Пила: растёт в течение суток и падает после удачной копии. Ровная растущая линия — копии не делаются."
    },
