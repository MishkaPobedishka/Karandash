      "title": "Возраст копии",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "backup_age_seconds",
          "legendFormat": "{{service}}",
          "refId": "A",
          "format": "time_series"
        }
